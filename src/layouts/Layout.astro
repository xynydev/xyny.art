---
import "@fontsource-variable/outfit";
import "@fontsource-variable/azeret-mono";
import "@fontsource-variable/roboto";
import "@fontsource-variable/atkinson-hyperlegible-next";
import "../styles/global.css";

interface Props {
    title: string;
    ogImage?: string;
    description?: string;
}

const {
    title,
    ogImage = "/og_image.png",
    description = "xyny's website and portfolio | new media art & programming",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/XYNY.svg" />
        <meta name="generator" content={Astro.generator} />

        <title>{title} | xyny.art</title>
        <meta name="description" content={description} />

        <meta property="og:url" content="https://xyny.art" />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="xyny.art" />
        <meta property="og:title" content={`${title} | xyny.art`} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImage} />

        <meta name="twitter:card" content="summary_large_image" />
        <meta property="twitter:domain" content="xyny.art" />
        <meta property="twitter:url" content="https://xyny.art" />
        <meta name="twitter:title" content={`${title} | xyny.art`} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />

        <script>
            if (
                (window.matchMedia("(prefers-color-scheme: dark)").matches ||
                    sessionStorage.getItem("dark") == "true") &&
                sessionStorage.getItem("dark") != "false"
            ) {
                document.body.classList.add("dark");
            }
        </script>

        <link
            rel="alternate"
            type="application/rss+xml"
            title="xyny's writings"
            href={new URL("blog/feed.xml", Astro.site)}
        />
    </head>
    <body class="font-sans">
        <slot />
    </body>
</html>

<style is:global>
    .prose ul {
        margin: 0em 0;
        list-style-type: square;
    }
</style>
