---
import Layout from "@layouts/Layout.astro";
import Header from "@components/basic/Header.astro";
import Footer from "@components/basic/Footer.astro";
---

<Layout title="order">
    <main class="dark:bg-black dark:text-white w-full min-h-screen">
        <Header />
        <iframe
            style="border:none;width:100%;height:100%;"
            id="xynys-custom-order-form-ifrowa"
            src="https://opnform.com/forms/xynys-custom-order-form-ifrowa"
        ></iframe>
        <script
            is:inline
            src="https://opnform.com/widgets/opnform-sdk.min.js"
        ></script>
        <Footer />
    </main>
</Layout>
