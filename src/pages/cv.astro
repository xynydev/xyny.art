---
import Layout from "@layouts/Layout.astro";
import Header from "@components/basic/Header.astro";
import Footer from "@components/basic/Footer.astro";

import { getEntry, render } from "astro:content";
const cv = await getEntry("cv", "cv");
const { Content } = await render(cv);
---

<Layout title="cv">
    <main class="dark:bg-black dark:text-white w-full min-h-screen prose-h1:font-serif prose-h1:italic prose-p:my-0!">
        <Header />
        <section class="prose dark:prose-invert prose-li:marker:text-black dark:prose-li:marker:text-white prose-ul:ps-4 prose-p:my-3 prose-img:my-2 prose-li:my-0 max-w-4xl mx-auto text-[#191919] dark:text-[#DDD] mt-6 pb-12 p-4">
            <Content />
        </section>
    </main>
    <Footer />
</Layout>
