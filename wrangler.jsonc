{
  "main": "@astrojs/cloudflare/entrypoints/server",
 	"name": "xynyart",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"observability": {
    "enabled": true
  }
}
